#include<stdio.h>

int main()
{
    int n;

    scanf("%d", &n);

    int arr[n];

    // Input array
    for(int i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    // Store last element
    int temp = arr[0];

    // Right shift
    for(int i = n - 1; i > 0; i--)
    {
        arr[i] = arr[i + 1];
    }

    // Place last element at first
    arr[n-1] = temp;

    // Print rotated array
    for(int i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }

    return 0;
}
