#include <stdio.h>

int main() {
    int n, k;
    scanf("%d", &n);

    int a[1000];

    for(int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &k);

    int count = 0;

    for(int i = 0; i < n; i++) {
        int sum = 0;

        for(int j = i; j < n; j++) {
            sum += a[j];

            if(sum > k)
                count++;
        }
    }

    printf("%d", count);

    return 0;
}
