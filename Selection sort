#include<stdio.h>
int main(){
    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
   
    for(int i=0;i<n;i++){
         int min=1;
        for(int j=i+1;j<n-1;j++){
            if(arr[j]<arr[min]){
                min=j;
                 int temp=arr[i];
            arr[i]=arr[min];
            arr[min]=temp;
            }
           
        }
        
    }   
    for(int i=0;i<n;i++){
        printf("%d ",arr[i]);
    }
    
    return 0;
}
