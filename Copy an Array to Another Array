#include<stdio.h>

int main()
{
    int n;

    scanf("%d", &n);

    int arr1[n], arr2[n];

    // Input first array
    for(int i = 0; i < n; i++)
    {
        scanf("%d", &arr1[i]);
    }

    // Copy arr1 to arr2
    for(int i = 0; i < n; i++)
    {
        arr2[i] = arr1[i];
    }

    // Print copied array
    printf("Copied array elements are:\n");

    for(int i = 0; i < n; i++)
    {
        printf("%d ", arr2[i]);
    }

    return 0;
}
