#include <stdio.h>
#include <string.h>

int main() {
    char str[100001];
    long long sum = 0;

    scanf("%s", str);

    int len = strlen(str);

    for(int i = 0; i < len; i++) {
        int digit = str[i] - '0';
        sum += digit * (i + 1);
    }

    printf("%lld", sum);

    return 0;
}
