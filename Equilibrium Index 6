#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int n=0;
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    int found=0;
    for(int i=0;i<n;i++){
        int leftsum=0;
        int rightsum=0;
        for(int j=0;j<i;j++){
            leftsum+=arr[j];
        }
        for(int j=i+1;j<n;j++){
            rightsum+=arr[j];
        }
         if(leftsum==rightsum){
        printf("%d",i);
        found=1;
        break;
    }
    }
   
    if(found==0){
        printf("-1");
    }
    return 0;
}
