#include<stdio.h>
int main(){
    int n,m;
    scanf("%d %d",&n,&m);
int arr1[n];
int arr2[m];
for(int i=0;i<n;i++){
    scanf("%d",&arr1[i]);
}
for(int i=0;i<m;i++){
    scanf("%d",&arr2[i]);
}

int merged[n+m];
int k=0;
for(int i=0;i<n;i++){
    merged[k]=arr1[i];
    k++;
}
for(int i=0;i<m;i++){
    merged[k]=arr2[i];
    k++;
}
for(int i=0;i<n+m;i++){
printf("%d",merged[i]);
}
return 0;
    
}
