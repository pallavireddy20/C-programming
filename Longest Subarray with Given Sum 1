Given an array and a number K, find the length of the longest contiguous subarray whose sum equals K. Example: Array: [1, 2, 3, 1, 1] Valid subarrays:
[1, 2] → length 2
[3] → length 1
    Maximum length = 2
Input Format
First line: Integer N Second line: Array elements Third line: Integer K
Constraints
1 ≤ N ≤ 1000
Output Format
Print maximum length
Sample Input 0
5
1 2 3 1 1
3
Sample Output 0
2
Sample Input 1
3
1 1 1
5
Sample Output 1
0

//code
#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
int main(){
    int n;
    scanf("%d" ,&n);
    int arr[n];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
          int k;
          scanf("%d",&k);
    int max_length=0;
    int length;
       
          for(int i=0;i<n;i++){
                int sum=0;
              for(int j=i;j<n;j++){  
              sum +=arr[j];
              if(sum==k){
                    length=j-i+1;
              }  
                  if(length>max_length){
                      max_length=length;
                  }
              }
          }
    printf("%d",max_length);
    
    return 0;
}
