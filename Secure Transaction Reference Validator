#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char s[100005];
    scanf("%s", s);

    int n = strlen(s);

    // Rule 1: 3 consecutive repeating chars
    for(int i=0; i<=n-3; i++) {
        if(s[i]==s[i+1] && s[i]==s[i+2]) {
            printf("FRAUD");
            return 0;
        }
    }

    // Rule 2: Entire string formed by repeating pattern
    for(int len=1; len<=n/2; len++) {
        if(n % len == 0) {
            int valid = 1;

            for(int i=len; i<n; i++) {
                if(s[i] != s[i%len]) {
                    valid = 0;
                    break;
                }
            }

            if(valid) {
                printf("FRAUD");
                return 0;
            }
        }
    }

    // Rule 3: Digits > Alphabets
    int digits=0, letters=0;

    for(int i=0;i<n;i++) {
        if(isdigit(s[i]))
            digits++;
        else if(isalpha(s[i]))
            letters++;
    }

    if(digits > letters) {
        printf("FRAUD");
        return 0;
    }

    // Rule 4: First 3 == Last 3
    if(n >= 6) {
        if(strncmp(s, s+n-3, 3)==0) {
            printf("FRAUD");
            return 0;
        }
    }

    printf("VALID");

    return 0;
}
