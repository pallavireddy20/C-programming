#include <stdio.h>
#include <math.h>

int isPerfectSquare(int x) {
    int r = sqrt(x);
    return r * r == x;
}

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];
    for(int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int count = 0;

    for(int i = 0; i < n; i++) {
        int sum = 0;
        for(int j = i; j < n; j++) {
            sum += arr[j];
            if(isPerfectSquare(sum)) {
                count++;
            }
        }
    }

    printf("%d\n", count);

    return 0;
}
